OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional — the Document Analyzer needs a model that accepts images. Only
# set this if OPENAI_MODEL is changed to one that doesn't.
# OPENAI_VISION_MODEL=gpt-4o-mini
PORT=3001

# Google Workspace SSO — OAuth 2.0 Client ID (type "Web application") from
# Google Cloud Console → APIs & Services → Credentials. See README.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only verified Google Workspace accounts on this domain can sign in.
ALLOWED_EMAIL_DOMAIN=orcarehab.com
# Signs the session cookie. Required when deployed; locally a random one is
# used if blank (everyone gets signed out when the server restarts).
# Generate with: openssl rand -hex 32
SESSION_SECRET=
